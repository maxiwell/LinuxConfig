	background = true,
	update_interval = 1,

	cpu_avg_samples = 2,
	net_avg_samples = 2,
	temperature_unit = 'celsius',

	double_buffer = true,
	no_buffers = true,
	text_buffer_size = 2048,

	gap_x = 80,
	gap_y = 40,
	minimum_width = 300, minimum_height = 900,
	maximum_width = 350,
	own_window = true,
	own_window_type = 'override',
	own_window_transparent = true,
	own_window_argb_visual = true,

	own_window_type = 'override',
	own_window_class = 'conky-semi',
	own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager,below',
	border_inner_margin = 0,
	border_outer_margin = 0,
	alignment = 'top_right',
-- monitor externo (DisplayPort); head 0 = eDP (primary)
	xinerama_head = 1,


	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,

	override_utf8_locale = true,
	use_xft = true,
	font = 'caviar dreams:size=11',
	xftalpha = 0.5,
	uppercase = false,

-- Defining colors
	default_color = '#FFFFFF',
-- Shades of Gray
	color1 = '#DDDDDD',
	color2 = '#AAAAAA',
	color3 = '#888888',
-- Orange
	color4 = '#EF5A29',
-- Green
	color5 = '#77B753',
-- Loading lua script for drawning rings
	lua_load = '/home/maxiwell/.conky/seamod/seamod_rings.lua',
	lua_draw_hook_pre = 'main',

};

--${offset 15}${font Ubuntu:size=11:style=normal}${color1}${pre_exec lsb_release -d | cut -f 2} - $sysname $kernel
conky.text = [[
${font Ubuntu:size=11:style=bold}${color4}SYSTEM ${hr 2}
${voffset 6}${offset 15}${font Ubuntu:size=11:style=normal}${color1}Kernel${goto 100}${color3}$sysname $kernel
${voffset 6}${offset 15}${color1}Uptime${goto 100}${color3}$uptime
${voffset 6}${offset 15}${color1}Load${goto 100}${color3}${loadavg 1}${goto 160}${loadavg 2}${goto 220}${loadavg 3}
${voffset 6}${offset 15}${color1}Battery${goto 100}${color3}${battery_bar 6,190 BAT0}${alignr}${battery_percent BAT0}%

# Showing CPU Graph
${voffset -18}
${offset 125}${cpugraph cpu0 40,220 666666 AAAAAA}${voffset -15}
${offset 90}${font Ubuntu:size=11:style=bold}${color5}CPU
# Showing TOP 5 CPU-consumers
${offset 105}${font Ubuntu:size=11:style=normal}${color4}${top name 1}${alignr}${top cpu 1}%
${offset 105}${color1}${top name 2}${alignr}${top cpu 2}%
${offset 105}${color2}${top name 3}${alignr}${top cpu 3}%
${offset 105}${color3}${top name 4}${alignr}${top cpu 4}%
${offset 105}${color3}${top name 5}${alignr}${top cpu 5}%

#Showing memory part with TOP 5
${voffset 20}
${offset 90}${font Ubuntu:size=11:style=bold}${color5}MEM${font Ubuntu:size=10:style=normal}${color3}${alignr}$mem / $memmax
${offset 105}${font Ubuntu:size=11:style=normal}${color4}${top_mem name 1}${alignr}${top_mem mem_res 1}
${offset 105}${color1}${top_mem name 2}${alignr}${top_mem mem_res 2}
${offset 105}${color2}${top_mem name 3}${alignr}${top_mem mem_res 3}
${offset 105}${color3}${top_mem name 4}${alignr}${top_mem mem_res 4}
${offset 105}${color3}${top_mem name 5}${alignr}${top_mem mem_res 5}

# Showing disk partitions: root, home
${voffset 20}
${offset 90}${font Ubuntu:size=11:style=bold}${color5}DISKS
${offset 130}${font Ubuntu:size=10:style=bold}${color1}Read${goto 180}${font Ubuntu:size=10:style=normal}${color2}${diskio_read}${alignr}${font Ubuntu:size=10:style=bold}${color1}Write  ${font Ubuntu:size=10:style=normal}${color2}${diskio_write}
${offset 130}${diskiograph 30,220 666666 AAAAAA}
${voffset 8}
${offset 130}${font Ubuntu:size=10:style=bold}${color1}Free  ${color3}${font Ubuntu:size=10:style=normal}${fs_free /}${alignr}${font Ubuntu:size=10:style=bold}${color1}Used  ${color3}${font Ubuntu:size=10:style=normal}${fs_used /}

${if_existing /sys/class/net/wlp3s0/operstate up}${voffset 10}
${offset 90}${font Ubuntu:size=11:style=bold}${color5}NETWORK
${offset 15}${font Ubuntu:size=10:style=bold}${color1}Lan IP${goto 100}${font Ubuntu:size=10:style=normal}${color3}${addr wlp3s0}
${offset 15}${font Ubuntu:size=10:style=bold}${color1}Ext IP${goto 100}${font Ubuntu:size=10:style=normal}${color3}${execi 600 wget -qO- http://ipecho.net/plain}
${voffset 8}
${offset 15}${font Ubuntu:size=10:style=bold}${color1}Up${goto 100}${font Ubuntu:size=10:style=normal}${color2}${upspeed wlp3s0}${alignr}${color3}total ${totalup wlp3s0}
${offset 15}${upspeedgraph wlp3s0 35,335 4B1B0C FF5C2B 1000000}
${voffset 4}
${offset 15}${font Ubuntu:size=10:style=bold}${color1}Down${goto 100}${font Ubuntu:size=10:style=normal}${color2}${downspeed wlp3s0}${alignr}${color3}total ${totaldown wlp3s0}
${offset 15}${downspeedgraph wlp3s0 35,335 324D23 77B753 1000000}
${endif}
${color4}${hr 2}
]];
